# =============================================================================
# CVO — docker compose environment (PRODUCTION)
#
#   cp .env.production.example .env.production
#   # then fill in every value marked CHANGE ME
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# NEVER commit the resulting .env.production (it is gitignored).
# See READMEProduction.md for the full deployment guide.
# =============================================================================

# -----------------------------------------------------------------------------
# Database — CHANGE ME
#
# The `db` service creates this database and user on first boot of an empty
# db_data volume; DB_ROOT_PASSWORD is used only by the container's own root
# account (healthcheck + admin).
# -----------------------------------------------------------------------------
DB_DATABASE=cvo
DB_USERNAME=cvo_user
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# -----------------------------------------------------------------------------
# Application — CHANGE ME
# -----------------------------------------------------------------------------

# Generate with:  printf 'base64:%s\n' "$(openssl rand -base64 32)"
# (with local PHP:  php artisan key:generate --show )
# The production entrypoint exits if this is empty.
APP_KEY=

# The PUBLIC origin the browser uses, including scheme (no trailing slash).
# Single-origin: this is the frontend's published port, behind TLS in a real
# deployment. Examples:
#   http://localhost:8080          (local smoke test of the prod stack)
#   https://cvo.example.gov.ph     (real deployment)
APP_URL=https://cvo.example.gov.ph

# Sanctum trusts these HOSTS (host:port, no scheme — not an origin).
# Single-origin: the same host the SPA is served from.
SANCTUM_STATEFUL_DOMAINS=cvo.example.gov.ph

# -----------------------------------------------------------------------------
# Cookies / CORS
# -----------------------------------------------------------------------------

# Empty => host-only cookie, which is correct for a single-origin deployment.
# Set it to the public domain only when TLS is terminated behind a proxy that
# rewrites the Host header.
SESSION_DOMAIN=

# Set to true once the app is served over HTTPS (a Secure cookie is never sent
# over plain HTTP, so keep this false only for a local http:// smoke test).
SESSION_SECURE_COOKIE=false

# Only used if some client calls the API cross-origin. Leave empty for the
# single-origin setup.
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Seeding — keep false in production
#
# true creates the two staff accounts on boot. Set it for one deploy, then set
# it back to false.
# -----------------------------------------------------------------------------
RUN_SEEDERS=false

# -----------------------------------------------------------------------------
# Published port / build args
# -----------------------------------------------------------------------------

# Host port for the single public entry point (the frontend's nginx).
WEB_PORT=8080

# BUILD-time value for the SPA. Empty => the bundle calls the API on its own
# origin and the frontend's nginx proxies /api, /sanctum, /storage,
# /secure-files and /up. Set an absolute URL only for a split-origin deploy,
# and rebuild afterwards (Vite inlines it during `vite build`).
VITE_API_URL=

# -----------------------------------------------------------------------------
# Mail — Gmail SMTP for password-reset codes
#
# MAIL_PASSWORD is a 16-character Google App password (Google Account >
# Security > 2-Step Verification > App passwords), not the Gmail login
# password. Keep it only in this untracked file or the platform's secret store.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=samplekylleuser@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=samplekylleuser@gmail.com
MAIL_FROM_NAME="CVO"

# Optional fixed password for the two seeded staff accounts. When empty,
# production generates one and prints it once in the seed output.
SEED_ACCOUNT_PASSWORD=
