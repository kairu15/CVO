# Tunnel mode template — copy to frontend/.env.ngrok and fill in the public host.
#
#   ngrok http 5174            # tunnel target
#   npm run dev:ngrok          # vite --mode ngrok
#
# VITE_API_URL must be empty so axios issues relative /api/... and /sanctum/...
# requests; the dev server proxies those to Laravel (see vite.config.js), which
# keeps the Sanctum cookie first-party over the tunnel.
VITE_API_URL=

# The public hostname (no scheme). Vite uses it for allowedHosts and the tunnel
# mode switch in vite.config.js. Must also be listed in backend/.env:
#   SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,<VITE_TUNNEL_HOST>
# Free accounts are assigned one domain and the agent reclaims it on restart, so
# this usually stays put — tools/ngrok-dev.ps1 rewrites both files anyway.
VITE_TUNNEL_HOST=your-subdomain.ngrok-free.dev

# Separate port so a normal `npm run dev` on 5173 can keep running.
VITE_DEV_PORT=5174

# Optional. Where Vite forwards /api and /sanctum. Defaults to
# http://127.0.0.1:8005 (see vite.config.js).
# VITE_API_PROXY_TARGET=http://127.0.0.1:8005
