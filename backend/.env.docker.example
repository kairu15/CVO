# =============================================================================
# CVO API — Laravel environment for the Docker stack
#
# The dev entrypoint copies this to .env when backend/.env is missing, and
# generates APP_KEY into it on first boot. docker-compose.yml also passes most
# of these as real container environment variables (which override this file),
# so it exists mainly to persist APP_KEY and to keep `php artisan` usable
# inside the container.
#
# DB_HOST is the compose service name `db`, NOT 127.0.0.1.
# =============================================================================

APP_NAME="CVO API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Host-reachable URL (the browser talks to the published port).
APP_URL=http://localhost:8005

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (compose network) ---------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cvo_api
DB_USERNAME=cvo
DB_PASSWORD=secret

# --- Session / Sanctum -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Empty => host-only cookie (works for localhost and 127.0.0.1).
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- SPA auth ----------------------------------------------------------------
# Hosts (host:port) allowed to use stateful Sanctum cookies. Mirrors the Vite
# dev origin; keep in sync with CORS_ALLOWED_ORIGINS and VITE_API_URL.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Security hardening (see config/security.php) ----------------------------
SECURITY_SESSION_IDLE=120
SECURITY_SESSION_ABSOLUTE=720
SECURITY_TOKEN_IDLE=240
SECURITY_TOKEN_ABSOLUTE=10080
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_LOCKOUT_WINDOW=60
SECURITY_UPLOAD_IMAGE_MAX_KB=2048
SECURITY_SIGNED_URL_MINUTES=30
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=31536000

# Address → coordinates (Nominatim). Inside the container the bundled CA store
# is used, so this can usually stay empty.
GEOCODING_CA_BUNDLE=
