# =============================================================================
# CVO — docker compose environment (PRODUCTION)
#
#   cp .env.production.example .env.production
#   # then fill in every value marked CHANGE ME and generate APP_KEY:
#   #   docker compose run --rm backend php artisan key:generate --show
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# NEVER commit the resulting .env.production (it is gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Database — CHANGE ME
# -----------------------------------------------------------------------------
DB_DATABASE=cvo_api
DB_USERNAME=cvo
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# -----------------------------------------------------------------------------
# Application — CHANGE ME
# -----------------------------------------------------------------------------

# Generate with:  php artisan key:generate --show
# (or, without a local PHP install:
#   docker compose --env-file .env.production -f docker-compose.prod.yml run --rm backend php artisan key:generate --show )
APP_KEY=

# The public origin the browser uses, including scheme. With the bundled
# single-origin setup that is the frontend's published port (behind TLS in a
# real deployment). Examples:
#   http://localhost:8080
#   https://cvo.example.com
APP_URL=http://localhost:8080

# Public port the frontend nginx listens on.
WEB_PORT=8080

# Sanctum trusts these HOSTS (host:port, no scheme). Single-origin: the same
# host the SPA is served from.
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# Only used if some client calls the API cross-origin. Leave empty for the
# single-origin setup.
CORS_ALLOWED_ORIGINS=

# Host-only cookie is fine single-origin. Set to the public domain if a proxy
# rewrites Host (e.g. cvo.example.com).
SESSION_DOMAIN=
# Set to true when served over HTTPS.
SESSION_SECURE_COOKIE=false

# Leave VITE_API_URL empty for the single-origin reverse-proxy setup so the
# bundle calls the API on its own origin. Set an absolute URL only when the
# frontend and API are on different origins.
VITE_API_URL=

# NEVER enable in production unless you deliberately want the demo accounts
# (admin@example.com / password) created.
RUN_SEEDERS=false
