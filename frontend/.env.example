# Copy to .env and adjust if your API runs elsewhere.
VITE_API_URL=http://localhost:8005

# Optional. Dev server port. Defaults to 5173 (see vite.config.js).
#
# Sanctum cookie auth is origin-locked, so whatever port you use here must be
# mirrored in backend/.env, or every login fails with a 419 or a CORS error:
#   SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
#   CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
#
# VITE_DEV_PORT=5174
