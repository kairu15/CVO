# =============================================================================
# CVO Frontend — nginx (production) — ENVSUBST TEMPLATE
#
# Rendered by nginx:alpine's /docker-entrypoint.d/20-envsubst-on-templates.sh
# at CONTAINER START into /etc/nginx/conf.d/default.conf. The script only
# substitutes variables that are actually DEFINED in the environment, so
# nginx's own runtime variables ($host, $uri, $scheme, $remote_addr, ...)
# are passed through untouched.
#
# WHY THE UPSTREAM IS A VARIABLE (the Render deploy crash)
#   These proxies used to say `proxy_pass http://backend:8080;` — the
#   docker-compose service name, which only resolves on the compose network.
#   nginx resolves a LITERAL upstream at startup, so on Render (no host called
#   `backend`) boot died before serving anything:
#       [emerg] host not found in upstream "backend" ... default.conf:36
#   ${BACKEND_UPSTREAM} is substituted BEFORE nginx starts, and the image bakes
#   in a default that resolves everywhere (http://localhost:8080), so the
#   container boots on Render with no dashboard config at all.
#
#   Values:
#     docker-compose.prod.yml  -> http://backend:8080   (single-origin proxy)
#     Render (default)         -> http://localhost:8080 (inert; see below)
#
#   SINGLE-ORIGIN ON RENDER
#     BACKEND_UPSTREAM=https://<api-host>.onrender.com and the SPA is built with
#     an EMPTY VITE_API_URL, so the browser only ever talks to THIS origin and
#     all five blocks below are live. The API is then reached over its public
#     URL, because free Render services cannot use private networking.
#
#   HOST HANDLING (why the blocks say `Host $proxy_host`, not `Host $host`)
#     An edge that routes by the Host header — Render does — would send a
#     request stamped with this service's host straight back to THIS service
#     and loop forever. Sending the upstream's own host ($proxy_host, which is
#     what `proxy_pass` names) addresses the backend directly.
#     Nothing that relies on the host breaks: a Set-Cookie with no Domain is
#     scoped by the BROWSER to the origin it actually called (this one), and
#     Sanctum's stateful check keys off the Origin/Referer header, which passes
#     through unchanged. X-Forwarded-Host carries the SPA's own host for an
#     app that trusts proxies.
#
# `backend` is the compose service name; it resolves on the compose network.
# =============================================================================

# Shared proxy headers. Kept as a snippet to avoid repeating five lines per
# location.
# (Defined inline below rather than via include so the whole config is visible
#  in one place in this image.)

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;

    # Matches the backend/php upload ceiling.
    client_max_body_size 12m;

    # Only used when ${BACKEND_UPSTREAM} is an https:// URL (Render). Without it
    # the upstream certificate is checked against the wrong SNI name.
    proxy_ssl_server_name on;

    # -------------------------------------------------------------------------
    # Backend routes — proxied to the Laravel container (nginx + php-fpm on 8080)
    #
    # $host        = the host the browser used (this service)
    # $proxy_host  = the host named in proxy_pass (the Laravel service)
    # -------------------------------------------------------------------------

    # Laravel API (versioned under /api/v1).
    location ^~ /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Sanctum's CSRF-cookie endpoint.
    location ^~ /sanctum/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public-disk uploads served by Laravel (the storage:link symlink).
    location ^~ /storage/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 7d;
        add_header Cache-Control "public";
    }

    # Signed media from the API's PRIVATE disk — avatars, visit photos and
    # dispersal signatures. App\Support\SecureMedia deliberately hands the SPA a
    # ROOT-RELATIVE /secure-files/...?signature=... URL (the signature is valid
    # on any host), so the browser resolves it against THIS origin. Without a
    # block here the request falls through to the SPA fallback below and every
    # avatar / photo renders as a broken image.
    location ^~ /secure-files/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Laravel's built-in health endpoint (used by the backend healthcheck too).
    location = /up {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # -------------------------------------------------------------------------
    # SPA
    # -------------------------------------------------------------------------

    # React Router owns client-side routes (/login, /dashboard/...), so unknown
    # paths must fall back to index.html instead of 404ing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html itself must not be cached, otherwise a redeploy keeps serving
    # the old bundle.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    # Vite emits content-hashed asset filenames, so they can be cached hard.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
}
