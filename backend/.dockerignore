# =============================================================================
# Build context for backend/Dockerfile.
#
# Anything excluded here is also absent from the image's auto-seeded volumes,
# so keep dev-only needs (tests/, seeders) — `php artisan test` runs inside the
# dev container.
# =============================================================================

# Dependencies are installed by the Dockerfile from composer.lock.
/vendor

# Node tooling (Vite/Tailwind) is not used by the API container.
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
# Created at runtime by `php artisan storage:link`; a dangling symlink here
# breaks the build context ("invalid file request public/storage").
/public/storage

# Environment files must never be baked into an image.
.env
.env.*
!.env.docker.example

# Local artefacts and logs.
*.log
*.sqlite
.phpunit.result.cache
/.phpunit.cache
_ide_helper.php
barangay_geocode.txt

# storage/ runtime content: volumes own these at runtime. Keep the directory
# structure (.gitignore placeholders) so the framework can write into it.
storage/app/*
!storage/app/.gitignore
storage/framework/cache/data/*
!storage/framework/cache/data/.gitignore
storage/framework/sessions/*
!storage/framework/sessions/.gitignore
storage/framework/views/*
!storage/framework/views/.gitignore
storage/logs/*
!storage/logs/.gitignore
storage/*.key
/storage/app/public

# VCS / editor.
.git
.gitignore
.gitattributes
.idea
.vscode
.DS_Store
Thumbs.db

# Container/CI definitions are not needed inside the image.
# NOTE: docker/ is NOT excluded — the Dockerfile copies files from it.
Dockerfile
.dockerignore
