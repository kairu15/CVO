# =============================================================================
# Build context for frontend/Dockerfile.
# =============================================================================

# Installed by `npm ci` in the image.
node_modules

# Build output is produced inside the image.
dist
dist-ssr

# Environment files: VITE_API_URL is passed as a build ARG for production and as
# a runtime env var for dev, so no .env should leak into the context.
.env
.env.*
!.env.example

# Logs / editor / VCS.
*.log
.vscode
.idea
.DS_Store

# Container definitions.
# NOTE: docker/ is NOT excluded — the Dockerfile copies docker/nginx.conf.
Dockerfile
.dockerignore
