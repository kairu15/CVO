APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8005

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cvo_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SPA auth: must match the Vite dev server origin exactly (scheme + host + port)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Security hardening (config/security.php — defaults there are production-
# intended; every value is overridable here)
# ---------------------------------------------------------------------------

# Session & token lifetimes in MINUTES. Idle = expire after inactivity;
# absolute = hard ceiling from login/issuance that no activity can renew.
SECURITY_SESSION_IDLE=120
SECURITY_SESSION_ABSOLUTE=720
SECURITY_TOKEN_IDLE=240
SECURITY_TOKEN_ABSOLUTE=10080

# "Remember me" recaller lifetime in MINUTES (config/auth.php). Only applies
# when the user ticks the box on the sign-in form; the session cookie itself
# still follows SESSION_LIFETIME. 43200 = 30 days.
AUTH_REMEMBER_MINUTES=43200

# Per-account lockout (item 2): after N consecutive failed logins for ONE
# account it is locked for SECURITY_LOCKOUT_MINUTES. Attempts are grouped by
# a sliding SECURITY_LOCKOUT_WINDOW so old failures do not count forever.
SECURITY_LOCKOUT_MAX_ATTEMPTS=5
SECURITY_LOCKOUT_MINUTES=15
SECURITY_LOCKOUT_WINDOW=60

# Uploads (item 8): avatar image size cap in KB; the extension allow-list is
# config-only (jpg, jpeg, png, webp).
SECURITY_UPLOAD_IMAGE_MAX_KB=2048

# Signed upload URLs (item 8): how long a photo/avatar link stays fetchable.
SECURITY_SIGNED_URL_MINUTES=30

# Headers (item 9). HSTS is sent automatically in production; set
# SECURITY_HSTS=true to force it on (staging behind real TLS) or false to
# force it off. Uncomment SECURITY_CSP only to override the default policy.
# SECURITY_CSP="default-src 'self'; ..."
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_HSTS_MAX_AGE=31536000

# Address → coordinates (Nominatim) lookups for the dispersal map.
# Windows/XAMPP PHP has no CA bundle by default (cURL error 60): download
# https://curl.se/ca/cacert.pem and point GEOCODING_CA_BUNDLE at it.
GEOCODING_CA_BUNDLE=
