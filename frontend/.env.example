# =============================================================================
# CVO Frontend — environment
#
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_.
# =============================================================================

# Base URL of the Laravel API, as seen FROM THE BROWSER.
#
#   Local `npm run dev` or the Docker dev stack : http://localhost:8005
#   Production single-origin (nginx proxy)     : leave empty (relative URLs)
#   Production split-origin                    : the API's absolute URL
#
# Never use a compose service name here (http://backend:8005) — the browser,
# not the container, makes the request and cannot resolve it.
VITE_API_URL=http://localhost:8005

# Optional dev-server port. Defaults to 5173 (see vite.config.js). Inside the
# Docker stack the port is fixed by the published mapping in docker-compose.yml;
# change FRONTEND_PORT there instead.
#
# Sanctum cookie auth is origin-locked, so a different port must be mirrored in
# the backend's SANCTUM_STATEFUL_DOMAINS / CORS_ALLOWED_ORIGINS:
#   SANCTUM_STATEFUL_DOMAINS=localhost:5174,127.0.0.1:5174
#   CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
#
# VITE_DEV_PORT=5174
