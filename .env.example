# =============================================================================
# CVO — docker compose environment (DEVELOPMENT)
#
#   cp .env.example .env
#
# Docker Compose reads this file automatically for docker-compose.yml. The
# values here are development defaults, not secrets. For production see
# .env.production.example instead.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_DATABASE=cvo_api
DB_USERNAME=cvo
DB_PASSWORD=secret
# Used only by the mysql container's own root account (healthcheck + admin).
DB_ROOT_PASSWORD=rootsecret

# Host port for the dev database. 3307 (not 3306) so a host XAMPP/standalone
# MySQL on 3306 can keep running. Set to "" to not publish the port at all.
DB_HOST_PORT=3307

# -----------------------------------------------------------------------------
# Published ports
# -----------------------------------------------------------------------------
API_PORT=8005
FRONTEND_PORT=5173
# phpMyAdmin (only with `--profile tools`).
PMA_PORT=8081

# -----------------------------------------------------------------------------
# API / Sanctum (development)
#
# These must line up with the origins the BROWSER actually uses:
#   frontend origin : http://localhost:5173
#   API origin      : http://localhost:8005
# -----------------------------------------------------------------------------

# Host-reachable URL of the API (used for URL generation).
API_URL=http://localhost:8005
# The SPA's base URL — a host URL, never http://backend:8005.
VITE_API_URL=http://localhost:8005

# Host-only cookie: works for both localhost and 127.0.0.1 in development.
# Set to a domain (e.g. localhost or cvo.example.com) to scope it explicitly.
SESSION_DOMAIN=

# Sanctum trusts these HOSTS (host:port, no scheme). The SPA on :5173 sends its
# session/CSRF cookies from here, so both spellings of localhost are listed.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# CORS allows these ORIGINS (scheme + host + port). Must match the dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed the demo accounts and sample data on boot. Off by default so a restart
# never recreates demo beneficiaries/users; set to true to seed once yourself.
RUN_SEEDERS=false
